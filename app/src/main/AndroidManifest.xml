<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Downloading iPhone app icons from the App Store -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Updates from GitHub Releases: bring up Wi-Fi for the download, then install the APK -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Workouts keep recording (heart rate, GPS) with the workout app closed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Answer calls on the watch through its own phone app (Settings → Answer calls on watch) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Restart the bridge after a reboot or app update -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Rest timer: the end-of-rest buzz must land on time, even in doze.
         USE_EXACT_ALARM is granted to timer apps on 13+; older systems use the
         auto-granted SCHEDULE_EXACT_ALARM (the code falls back to a window either way). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Sleep quiet mode: step counter to tell sleep from wake, Do Not Disturb, and turning off
         raise-to-wake. The last one can only be granted with adb (pm grant). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Heart rate for Apple Health, collected passively by Health Services -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Screen timeout and 24-hour time, changed from the iPhone app (appops, granted with adb) -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- The WristLink watch faces, and data from other apps (Samsung Health's heart rate and blood
         oxygen) in their slots. Tapping an empty slot asks for it; the installer grants it. -->
    <uses-permission android:name="com.google.android.permission.PROVIDE_BACKGROUND" />
    <uses-permission android:name="com.google.android.wearable.permission.RECEIVE_COMPLICATION_DATA" />

    <!-- Declare BLE feature -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- The app under its old name, whose data LegacyImport takes over once -->
    <queries>
        <package android:name="com.watchbridge" />
    </queries>

    <application
        android:name=".WristLinkApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Wear OS standalone flag — no companion app required -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Second launcher icon, "Music Control": opens straight into the media controls -->
        <activity
            android:name=".ui.MediaActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_media"
            android:label="@string/media_app_name"
            android:taskAffinity="com.wristlink.media">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Third launcher icon, "Camera Remote": shutter button for the iPhone Camera app -->
        <activity
            android:name=".ui.CameraRemoteActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_camera"
            android:label="@string/camera_app_name"
            android:taskAffinity="com.wristlink.camera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fourth launcher icon, "Rest Timer": standalone between-sets timer -->
        <activity
            android:name=".ui.RestTimerActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_timer"
            android:label="@string/timer_app_name"
            android:taskAffinity="com.wristlink.timer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fifth launcher icon, "Workout": runs, rides and gym workouts with Health Services -->
        <activity
            android:name=".workout.WorkoutActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_workout"
            android:label="@string/workout_app_name"
            android:launchMode="singleTask"
            android:taskAffinity="com.wristlink.workout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the workout session so it survives the workout app closing -->
        <service
            android:name=".workout.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <activity
            android:name=".ui.IncomingCallActivity"
            android:exported="false"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance" />

        <activity
            android:name=".ui.OngoingCallActivity"
            android:exported="false"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <service
            android:name=".service.WristLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Heart rate every 10 minutes (HeartRateSampler), from its own alarm -->
        <receiver
            android:name=".health.HeartRateSampler$Receiver"
            android:exported="false" />

        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <!-- Health Services hands passive data batches to this service -->
        <service
            android:name=".health.PassiveHealthService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING" />

        <!-- Periodic sleep check (SleepGuard) -->
        <receiver
            android:name=".sleep.SleepGuardReceiver"
            android:exported="false" />

        <!-- Buttons on the now playing notification -->
        <receiver
            android:name=".ams.MediaActionReceiver"
            android:exported="false" />

        <!-- Connection status tile -->
        <service
            android:name=".tile.ConnectionTileService"
            android:exported="true"
            android:icon="@drawable/ic_bluetooth"
            android:label="@string/tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- Now playing tile with previous / play-pause / next -->
        <service
            android:name=".tile.MediaTileService"
            android:exported="true"
            android:icon="@drawable/ic_music_note"
            android:label="@string/media_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_media" />
        </service>

        <!-- Weather from the iPhone: tile, and complications for any watch face -->
        <service
            android:name=".tile.WeatherTileService"
            android:exported="true"
            android:icon="@drawable/ic_weather_partly_day"
            android:label="@string/weather_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- Complications hand the face a timeline, so they need no frequent updates; the period
             only catches faces that ignore timelines -->
        <service
            android:name=".weather.WeatherComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_weather_partly_day"
            android:label="@string/weather_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>

        <service
            android:name=".weather.SunComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_sunrise"
            android:label="@string/sun_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>

        <!-- The WristLink watch face: time, the iPhone's weather in the middle, two slots -->
        <service
            android:name=".watchface.WristLinkWatchFaceService"
            android:exported="true"
            android:label="@string/watch_face_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@drawable/watch_face_preview" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview_circular"
                android:resource="@drawable/watch_face_preview" />
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/watch_face" />
            <!-- "Customize" opens FaceEditorActivity -->
            <meta-data
                android:name="com.google.android.wearable.watchface.wearableConfigurationAction"
                android:value="androidx.wear.watchface.editor.action.WATCH_FACE_EDITOR" />
        </service>

        <!-- The WristLink Dashboard face: four rim gauges, the time, a weather card -->
        <service
            android:name=".watchface.DashboardWatchFaceService"
            android:exported="true"
            android:label="@string/watch_face_dashboard_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
                <category android:name="com.google.android.wearable.watchface.category.WATCH_FACE" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.wearable.watchface.preview"
                android:resource="@drawable/watch_face_dashboard_preview" />
            <meta-data
                android:name="com.google.android.wearable.watchface.preview_circular"
                android:resource="@drawable/watch_face_dashboard_preview" />
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/watch_face" />
            <!-- "Customize" opens FaceEditorActivity -->
            <meta-data
                android:name="com.google.android.wearable.watchface.wearableConfigurationAction"
                android:value="androidx.wear.watchface.editor.action.WATCH_FACE_EDITOR" />
        </service>

        <!-- Editor for both WristLink faces: their slots and accent color -->
        <activity
            android:name=".watchface.FaceEditorActivity"
            android:exported="true"
            android:label="@string/watch_face_editor"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="androidx.wear.watchface.editor.action.WATCH_FACE_EDITOR" />
                <category android:name="com.google.android.wearable.watchface.category.WEARABLE_CONFIGURATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- End-of-rest buzz, fired by AlarmManager so it survives doze and app death -->
        <receiver
            android:name=".timer.RestTimerAlarmReceiver"
            android:exported="false" />

        <!-- Rest timer tile: presets one swipe from the watch face -->
        <service
            android:name=".tile.RestTimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_timer"
            android:label="@string/timer_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_timer" />
        </service>

        <!-- Fifth launcher icon, "Health": today's activity, heart rate, sleep, profile -->
        <activity
            android:name=".ui.HealthActivity"
            android:exported="true"
            android:icon="@drawable/ic_launcher_health"
            android:label="@string/health_app_name"
            android:taskAffinity="com.wristlink.health">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Heart rate and inactivity alerts: the inactivity alarm and its "Not now" button -->
        <receiver
            android:name=".health.HealthAlertReceiver"
            android:exported="false" />

        <!-- Health tiles -->
        <service
            android:name=".tile.ActivityTileService"
            android:exported="true"
            android:icon="@drawable/ic_steps"
            android:label="@string/activity_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_health" />
        </service>

        <service
            android:name=".tile.HeartRateTileService"
            android:exported="true"
            android:icon="@drawable/ic_heart"
            android:label="@string/heart_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_health" />
        </service>

        <service
            android:name=".tile.SleepTileService"
            android:exported="true"
            android:icon="@drawable/ic_sleep"
            android:label="@string/sleep_tile_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/ic_launcher_health" />
        </service>

        <!-- Our own heart rate and steps for any watch face. LiveHealth pushes updates when new
             data arrives (period 0 = no polling). -->
        <service
            android:name=".health.HeartRateComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_heart"
            android:label="@string/heart_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <service
            android:name=".health.ActivityComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_steps"
            android:label="@string/steps_complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="GOAL_PROGRESS,RANGED_VALUE,SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

        <!-- Launched by the tile's Reconnect chip; tiles can only start activities -->
        <activity
            android:name=".tile.ReconnectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>

</manifest>
